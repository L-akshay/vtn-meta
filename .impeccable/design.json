      "kind": "nav",
      "description": "Text controls on a black stage; selection is encoded by text and a lower rule.",
      "html": "<nav class=\"ds-controls\" aria-label=\"Explore note transformations\"><button class=\"ds-control\" aria-pressed=\"true\">Live</button><button class=\"ds-control\" aria-pressed=\"false\">Clean up</button><button class=\"ds-control\" aria-pressed=\"false\">Summary</button><button class=\"ds-control\" aria-pressed=\"false\">Rephrase</button></nav>",
      "css": ".ds-controls{font-family:var(--font-geist,Geist),sans-serif;display:flex;justify-content:space-between;background:#000;border-bottom:1px solid #373739;}.ds-control{font-family:var(--font-geist,Geist),sans-serif;background:transparent;border:0;border-bottom:2px solid transparent;color:#a2a2a8;min-height:48px;padding:8px 0;font-size:11px;cursor:pointer;}.ds-control[aria-pressed=\"true\"]{color:white;border-color:white;}.ds-primary:focus-visible,.ds-sticky:focus-visible,.ds-control:focus-visible,.ds-row:focus-visible,.ds-nav a:focus-visible {outline:3px solid var(--action,#db123f);outline-offset:5px;}",
