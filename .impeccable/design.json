    {
      "name": "Recording tray",
      "kind": "card",
      "description": "Small bordered product surface; waveform and elapsed time are functional recording detail.",
      "html": "<div class=\"ds-tray\"><div class=\"ds-wave\" aria-hidden=\"true\"><span style=\"height:10px\"></span><span style=\"height:17px\"></span><span style=\"height:29px\"></span><span style=\"height:20px\"></span><span style=\"height:12px\"></span><span style=\"height:34px\"></span><span style=\"height:25px\"></span><span style=\"height:16px\"></span><span style=\"height:28px\"></span><span style=\"height:37px\"></span><span style=\"height:22px\"></span><span style=\"height:12px\"></span><span style=\"height:30px\"></span><span style=\"height:20px\"></span><span style=\"height:14px\"></span><span style=\"height:24px\"></span><span style=\"height:11px\"></span></div><div class=\"ds-recording-meta\"><span>Voice note</span><span>0:18</span></div></div>",
      "css": ".ds-tray{font-family:var(--font-geist,Geist),sans-serif;border:1px solid #e8e8ec;border-radius:14px;padding:10px 14px;background:var(--bg,#ffffff);}.ds-wave{display:flex;gap:3px;align-items:center;justify-content:center;height:37px;}.ds-wave span{display:block;width:3px;border-radius:3px;background:var(--action,#db123f);}.ds-recording-meta{display:flex;justify-content:space-between;color:var(--ink-2,#6e6e73);font-size:9px;margin-top:6px;font-variant-numeric:tabular-nums;}",
      "refersTo": "recording-tray"
