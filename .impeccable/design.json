      "css": ".ds-nav{font-family:var(--font-geist,Geist),sans-serif;display:flex;gap:18px;color:var(--ink,#1d1d1f);}.ds-nav a{display:inline-flex;align-items:center;min-height:48px;font-size:11px;color:inherit;text-decoration:none;text-underline-offset:5px;}.ds-nav a:hover{text-decoration:underline;}.ds-primary:focus-visible,.ds-sticky:focus-visible,.ds-control:focus-visible,.ds-row:focus-visible,.ds-nav a:focus-visible {outline:3px solid var(--action,#db123f);outline-offset:5px;}"
