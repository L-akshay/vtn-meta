    {
      "name": "Illustrated note content",
      "kind": "custom",
      "description": "Product-specific hierarchy with a semantic date, title, and derived writing; tiny date text is local product metadata.",
      "html": "<article class=\"ds-note\"><div class=\"ds-date\">Today <span>&middot;</span> Personal notes</div><div class=\"ds-note-title\">A useful thought</div><p>Capture the thought while it is fresh.</p><div class=\"ds-rule\"></div><div class=\"ds-note-heading\">Summary</div><p>Keep the important parts ready to revisit.</p></article>",
      "css": ".ds-note{font-family:var(--font-geist,Geist),sans-serif;padding:21px 19px;background:#f7f7f8;color:var(--ink,#1d1d1f);font-size:12px;line-height:1.65;}.ds-date{font-size:9px;color:var(--ink-2,#6e6e73);margin-bottom:9px;}.ds-date span{margin-inline:4px;}.ds-note-title{font-size:21px;line-height:1.17;letter-spacing:-.035em;font-weight:600;text-wrap:pretty;margin-bottom:17px;}.ds-note p{margin:0;color:#4d4d52;}.ds-rule{height:1px;background:#dedee3;margin:15px 0 12px;}.ds-note-heading{font-size:11px;font-weight:650;margin:10px 0 7px;}"
    }
