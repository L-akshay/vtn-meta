    },
    {
      "name": "Audience navigation row",
      "kind": "nav",
      "description": "Flat linked content row with a directional vector icon.",
      "html": "<a class=\"ds-row\" href=\"#students\"><div><h3>Be in the lecture.</h3><p>Leave the typing behind. Capture the lesson and come back to the important parts.</p><span>Explore notes for students</span></div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a>",
      "css": ".ds-row{font-family:var(--font-geist,Geist),sans-serif;display:grid;grid-template-columns:1fr 24px;gap:12px;border-top:1px solid var(--line,#d2d2d7);padding:27px 0 31px;color:var(--ink,#1d1d1f);text-decoration:none;}.ds-row h3{margin:0;font-size:23px;font-weight:500;line-height:1.2;letter-spacing:-.025em;}.ds-row p{margin:11px 0 0;font-size:14px;line-height:23px;max-width:43ch;color:var(--ink-2,#6e6e73);}.ds-row span{display:block;font-size:11px;margin-top:20px;color:var(--ink-2,#6e6e73);}.ds-row>svg{margin-top:1px;transition:transform 180ms;}.ds-row:hover>svg{transform:translate(3px,-3px);}.ds-primary:focus-visible,.ds-sticky:focus-visible,.ds-control:focus-visible,.ds-row:focus-visible,.ds-nav a:focus-visible {outline:3px solid var(--action,#db123f);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-row>svg{transition:none;}}",
      "refersTo": "campaign-row"
